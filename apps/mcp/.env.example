PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/payo
SOLARI_API_KEY=your_solari_api_key
SOLARI_PROFILE_ID=your_solari_profile_id
PLATFORM_CARD_NUMBER=4000000000000000
PLATFORM_CARD_EXPIRY=12/28
PLATFORM_CARD_CVV=123
QUICKCOMMERCE_API_KEY=your_qc_key
ZEPTO_CARD_INSTRUMENT_CODE=CARD_XXXXXX

# ── OAuth 2.1 (ChatGPT plugin) ────────────────────────────────────────────────
# Canonical public origin of THIS server. Access tokens are audience-bound to
# ${PAYO_MCP_PUBLIC_ORIGIN}/mcp, so this must exactly match the MCP URL you
# submit to the OpenAI Plugins portal.
PAYO_MCP_PUBLIC_ORIGIN=http://localhost:4000

# Must be identical to apps/web's BETTER_AUTH_SECRET — both apps share one
# user/session table via @repo/db.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Reuse the dashboard's login paths for the OAuth flow
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to "true" once OAuth works in staging. While "false", /mcp keeps
# accepting API keys and session cookies so nothing breaks.
MCP_REQUIRE_OAUTH=false

# Set on the host (not in git) to the token the Plugins portal asks you to serve
# at /.well-known/openai-apps-challenge
OPENAI_APPS_CHALLENGE_TOKEN=
